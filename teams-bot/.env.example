# Bot registration credentials (see README.md "Real Teams configuration")
# Leave these BLANK to run locally against the Microsoft 365 Agents
# Playground (skipAuth mode, no Azure/dev-tunnel needed). Fill them in only
# when testing against real Teams via sideload.
CLIENT_ID=
CLIENT_SECRET=
TENANT_ID=

# Local asynchronous analysis endpoint; no credentials belong in this URL.
ANALYZE_API_URL=http://127.0.0.1:8000/analyze

# Local server port for this bot (must match your dev tunnel forwarding)
PORT=3978

# Choose backend: ollama (local inference), openai (any OpenAI-compatible
# endpoint), or azure_ai_foundry (model deployed on Azure AI Foundry, Entra
# ID auth via DefaultAzureCredential - no API key needed).
LLM_BACKEND=ollama
LLM_MODEL=llama3.1
# Model weights have their own license. Local inference does not disable
# external web grounding, which can send formula fragments to search providers.

# Only needed if LLM_BACKEND=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Only needed if LLM_BACKEND=azure_ai_foundry
# AZURE_AI_FOUNDRY_ENDPOINT=https://<your-resource>.services.ai.azure.com/anthropic
# AZURE_AI_FOUNDRY_DEPLOYMENT=claude-opus-5
